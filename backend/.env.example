# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=upwork_stable

# Scrapfly Configuration
SCRAPFLY_API_KEY=your_scrapfly_api_key_here
SCRAPFLY_COUNTRY=US

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Scraping Configuration
MAX_CONCURRENT_REQUESTS=5
SEARCH_PAGE_WAIT_SELECTOR=div[data-test="job-tile"]
DETAIL_PAGE_WAIT_SELECTOR=div[data-test="job-description"]

# Cache Configuration
CACHE_ENABLED=true
CACHE_DIR=./cache
CACHE_TTL_SECONDS=3600

# SSE Configuration
SSE_RETRY_TIMEOUT=5000
SSE_KEEPALIVE_INTERVAL=30
